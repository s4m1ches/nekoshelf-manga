<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- NEKOSHELF --> <!-- Bridge to Nekoshelf Launcher; only the nekoshelf build exposes it. -->
    <permission
        android:name="app.nekoshelf.manga.permission.BRIDGE"
        android:protectionLevel="signature" />

    <application
        android:label="@string/nekoshelf_app_name"
        tools:replace="android:label">

        <provider
            android:name="komikku.nekoshelf.bridge.BridgeProvider"
            android:authorities="app.nekoshelf.manga.bridge"
            android:exported="true"
            android:readPermission="app.nekoshelf.manga.permission.BRIDGE" />

        <activity
            android:name="komikku.nekoshelf.bridge.BridgeOpenActivity"
            android:exported="true"
            android:permission="app.nekoshelf.manga.permission.BRIDGE"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="app.nekoshelf.manga.action.OPEN_MANGA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
